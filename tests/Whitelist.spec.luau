local server=game:GetService("ServerScriptService")
assert(server:FindFirstChild("AccessControl"),"AccessControl module is missing")
assert(server:FindFirstChild("WhitelistPolicy"),"WhitelistPolicy module is missing")
local Policy=require(server.WhitelistPolicy)
local now=DateTime.fromIsoDate("2026-11-05T00:00:00Z").UnixTimestamp
local function evaluate(data) return Policy.evaluate(data,now) end
assert(not evaluate(nil))
assert(not evaluate({allowed="true",source="user_whitelist_access",duration_type="permanent"}))
assert(not evaluate({allowed=true,source="legacy_trial",duration_type="permanent"}))
assert(not evaluate({allowed=true,source="user_whitelist_access",duration_type="days",expires_at="not a date"}))
local allowed,premium,expires,status=evaluate({allowed=false,reason="expired"})
assert(not allowed and status=="Expired")
allowed,premium,expires,status=evaluate({allowed=true,source="user_whitelist_access",duration_type="days",expires_at="2026-11-04T00:00:00Z",is_premium=true})
assert(not allowed and status=="Expired")
allowed,premium,expires,status=evaluate({allowed=true,source="user_whitelist_access",duration_type="days",expires_at="2026-11-06T00:00:00Z",is_premium=true})
assert(allowed and premium and expires>now and status=="Premium")
allowed,premium,expires,status=evaluate({allowed=true,source="user_whitelist_access",duration_type="permanent",is_premium=false})
assert(allowed and not premium and expires==0 and status=="Regular")
local clone=server.AccessControl:Clone()
local Access=require(clone)
local player=Instance.new("Folder")
assert(not Access.allowed(player))
player:SetAttribute("GameAccessAllowed",true)
assert(not Access.allowed(player),"Replicated attributes must not grant server access")
Access.set(player,true,"Regular",253402300799)
assert(Access.allowed(player) and player:GetAttribute("GameAccessAllowed")==true)
Access.set(player,true,"Premium",1)
assert(not Access.allowed(player) and player:GetAttribute("GameAccessAllowed")==false)
Access.set(player,false,"Pending",0)
assert(player:GetAttribute("GameAccessStatus")=="Pending")
Access.set(player,true,"Premium",0)
assert(Access.allowed(player))
Access.remove(player)
assert(not Access.allowed(player))
Access.changed:Destroy() player:Destroy() clone:Destroy()
return "Whitelist policy and authoritative access checks passed"
