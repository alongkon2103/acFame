-- Run in Studio Client with the installed FameUI module.
local parent=Instance.new("Folder")
local ui=require(game.ReplicatedStorage.ACFame.FameUI).new({PlayerGui=parent})
ui:setPermission(true)
assert(ui.connectionToggle.Visible)
ui:setConnection("CONNECTING", "test")
assert(not ui.connectButton.Active and not ui.channelInput.TextEditable)
assert(ui.disconnectButton.Visible)
ui:setConnection("LIVE", "test")
assert(ui.status.Text:find("@test",1,true))
assert(ui.connectButton.Active and ui.channelInput.TextEditable)
ui:setConnection("ERROR", "test")
assert(ui.connectionMessage.Text:find("try",1,true))
ui:setView(false)
assert(ui.viewButton.Active and ui.viewButton.Text=="Live camera")
ui:setView(true)
assert(ui.viewButton.Text=="Explore")
ui:setOverlay("https://example.com/overlay?view="..string.rep("a",64))
assert(ui.selectOverlay.Active and #ui.overlayLink.Text>64)
assert(ui.selectActivity.Active and ui.activityLink.Text:find("/overlay/activity?view=",1,true))
assert(ui.overlayLink.TextTruncate==Enum.TextTruncate.AtEnd)
ui.connectPanel.Visible=true
ui:setCinematic(true)
assert(not ui.chrome.Visible)
ui:setCinematic(false)
assert(ui.chrome.Visible and ui.connectPanel.Visible)
ui:setPermission(false)
assert(not ui.connectionToggle.Visible and not ui.connectPanel.Visible)
for _,kind in ipairs({"comment","follow","rose","necklace","donut","heart"}) do assert(ui.demoButtons[kind]) end
parent:Destroy()
return "FameUI state, permission, overlay, cinematic restore and all six demo controls passed"
